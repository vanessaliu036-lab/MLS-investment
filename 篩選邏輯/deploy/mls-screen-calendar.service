[Unit]
Description=MLS 篩選邏輯 更新交易日行事曆 (TWSE 官方假日 → holidays.json)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/mls-screen
Environment="HOME=/root"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/mls-screen/deploy/run_calendar.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mls-screen-calendar
