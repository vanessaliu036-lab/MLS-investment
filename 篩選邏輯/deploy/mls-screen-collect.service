[Unit]
Description=MLS 篩選邏輯 盤後採集 + 落地明日盤前名單 (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/mls-screen
Environment="HOME=/root"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/mls-screen/deploy/run_collect.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mls-screen-collect
