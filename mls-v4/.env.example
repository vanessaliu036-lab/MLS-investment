# MLS v4.0 環境變數範本
# 複製為 .env 並填入真實值。未填則系統以 demo 模式啟動（可先看畫面）。

# ── 資料模式 ──
# demo = 用內建示意資料（預設，未接 API 時用）
# real = 接真實 Shioaji + FinMind
MLS_DATA_MODE=demo

# ── Shioaji（永豐）──
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_CA_PATH=
SHIOAJI_CA_PASSWD=
SHIOAJI_PERSON_ID=

# ── FinMind ──
FINMIND_TOKEN=

# ── 服務 ──
MLS_PORT=8000
MLS_DB_PATH=/opt/mls-v4/app/data/mls.db
MLS_REPORT_DIR=/opt/mls-v4/app/data/reports

# ── 門檻（選填，有預設）──
# MLS_READY_MIN=65
# MLS_WATCH_MIN=50
# MLS_SUCCESS_PCT=2.0

# ── Telegram（選填）──
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
