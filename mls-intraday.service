[Unit]
Description=mls-intraday 51-file watch pool (VPS)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mls-intraday/個股卡片相關檔案_20260722
Environment="HOME=/root"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 -m uvicorn server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=append:/tmp/mls-intraday.log
StandardError=append:/tmp/mls-intraday.log

[Install]
WantedBy=multi-user.target
